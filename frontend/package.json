{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/apply-coaches-ui.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/apply-coaches-ui.mjs",
    "build": "next build --webpack",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "prelint": "node scripts/apply-coaches-ui.mjs",
    "lint": "eslint",
    "pretypecheck": "node scripts/apply-coaches-ui.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/apply-coaches-ui.mjs",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "lucide-react": "^1.33.0",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.158.0"
  }
}
