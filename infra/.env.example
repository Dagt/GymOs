GYMOS_SMTP_PASSWORD=replace-me
GYMOS_SMTP_AUTH=true
GYMOS_SMTP_STARTTLS=true
GYMOS_SMTP_SSL=false
GYMOS_SMTP_CONNECTION_TIMEOUT_MS=10000
