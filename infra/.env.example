POSTGRES_DB=gymos
POSTGRES_USER=gymos
POSTGRES_PASSWORD=change-me
GYMOS_DB_URL=jdbc:postgresql://postgres:5432/gymos
GYMOS_DB_USERNAME=gymos
GYMOS_DB_PASSWORD=change-me
GYMOS_REDIS_HOST=redis
GYMOS_REDIS_PORT=6379
GYMOS_MINIO_ENDPOINT=http://minio:9000
GYMOS_MINIO_ACCESS_KEY=change-me
GYMOS_MINIO_SECRET_KEY=change-me
GYMOS_MINIO_BUCKET=gymos-receipts
GYMOS_JWT_SECRET=replace-with-64-plus-random-characters
GYMOS_CORS_ALLOWED_ORIGINS=https://gymos.example.com
GYMOS_SEED_ENABLED=false
# Sólo para desarrollo local: al habilitarlo, ambos valores son obligatorios.
GYMOS_DEMO_OWNER_EMAIL=
GYMOS_DEMO_OWNER_PASSWORD=
# Bootstrap temporal del primer administrador GymFort. Déjalo deshabilitado salvo durante esa creación.
GYMOS_PLATFORM_BOOTSTRAP_ENABLED=false
GYMOS_PLATFORM_ADMIN_EMAIL=
GYMOS_PLATFORM_ADMIN_PASSWORD=
GYMOS_PLATFORM_ADMIN_NAME=
# Después del primer acceso: vuelve a false, elimina la contraseña y retira correo/nombre si ya no se necesitan.
GYMOS_PAYMENT_CREDENTIAL_KEY=replace-with-an-independent-64-plus-random-character-secret
GYMOS_FRONTEND_BASE_URL=http://localhost:3000
GYMOS_STRIPE_SECRET_KEY=sk_test_replace_me
# Inicia stripe-listener, copia el whsec_ que imprime y reinicia backend con este valor.
GYMOS_STRIPE_WEBHOOK_SECRET=whsec_replace_after_starting_listener
GYMOS_STRIPE_RETURN_URL=http://localhost:3000/settings/organization?payment=stripe-return
GYMOS_STRIPE_REFRESH_URL=http://localhost:3000/settings/organization?payment=stripe-refresh
GYMOS_NOTIFICATION_PREFERENCE_KEY=replace-with-an-independent-64-plus-random-character-secret
GYMOS_SMTP_ENABLED=false
# ZeptoMail: usa las credenciales exactas del Agent > SMTP/API. El host oficial es smtp.zeptomail.com.
GYMOS_SMTP_PROVIDER_NAME=ZeptoMail
GYMOS_SMTP_HOST=smtp.zeptomail.com
GYMOS_SMTP_PORT=587
# ZeptoMail normalmente muestra "emailapikey" como usuario SMTP; respeta siempre el valor mostrado por el Agent.
GYMOS_SMTP_USERNAME=emailapikey
# Usa la contraseña SMTP generada en el Agent de ZeptoMail. Nunca la publiques ni la envíes al frontend.
GYMOS_SMTP_PASSWORD=replace-with-zeptomail-smtp-password
# Remitentes verificados/asociados al Agent, separados por coma. Puede incluir identidades de distintos gimnasios si sus dominios ya fueron verificados.
GYMOS_SMTP_ALLOWED_FROM_ADDRESSES=notificaciones@gymfort.mx
GYMOS_SMTP_AUTH=true
GYMOS_SMTP_STARTTLS=true
GYMOS_SMTP_STARTTLS_REQUIRED=true
GYMOS_SMTP_SSL=false
GYMOS_SMTP_CHECK_SERVER_IDENTITY=true
GYMOS_SMTP_CONNECTION_TIMEOUT_MS=10000
GYMOS_SMTP_READ_TIMEOUT_MS=10000
GYMOS_SMTP_WRITE_TIMEOUT_MS=10000
NEXT_PUBLIC_API_BASE_URL=https://api.gymos.example.com/api/v1
