POSTGRES_DB=gymos
POSTGRES_USER=gymos
POSTGRES_PASSWORD=change-me
GYMOS_DB_URL=jdbc:postgresql://postgres:5432/gymos
GYMOS_DB_USERNAME=gymos
GYMOS_DB_PASSWORD=change-me
GYMOS_REDIS_HOST=redis
GYMOS_REDIS_PORT=6379
GYMOS_MINIO_ENDPOINT=http://minio:9000
GYMOS_MINIO_ACCESS_KEY=change-me
GYMOS_MINIO_SECRET_KEY=change-me
GYMOS_MINIO_BUCKET=gymos-receipts
GYMOS_JWT_SECRET=replace-with-64-plus-random-characters
GYMOS_CORS_ALLOWED_ORIGINS=https://gymos.example.com
GYMOS_SEED_ENABLED=false
GYMOS_NOTIFICATION_PREFERENCE_KEY=replace-with-an-independent-64-plus-random-character-secret
